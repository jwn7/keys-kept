# Google Cloud Console → OAuth 2.0 클라이언트 ID (웹 애플리케이션). 승인된 JavaScript 원본에 http://localhost:5173 추가.
# 스코프는 drive.file (non-sensitive). 비어 있으면 Drive 연결 버튼이 비활성화되고 로컬 전용으로 동작한다.
VITE_GOOGLE_CLIENT_ID=

# Pro (Supabase). 둘 다 있으면 설정 > 동기화 > 업그레이드가 활성화된다. Supabase Auth의 Google provider를 켜둔다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
