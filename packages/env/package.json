{
  "name": "keys-kept",
  "version": "0.1.0",
  "description": "Run commands with keys from an encrypted .env.age, without a plaintext .env. Includes an MCP server so AI coding tools use keys by name, never by value.",
  "keywords": [
    "env",
    "dotenv",
    "secrets",
    "age",
    "mcp",
    "claude",
    "api-keys",
    "encryption"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwn7/vault-notes.git",
    "directory": "packages/env"
  },
  "homepage": "https://github.com/jwn7/vault-notes/tree/main/packages/env#readme",
  "bugs": {
    "url": "https://github.com/jwn7/vault-notes/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "mcpName": "io.github.jwn7/keys-kept",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./load": "./src/load.mjs",
    "./flow": "./src/flow.mjs"
  },
  "bin": {
    "keys-kept": "./bin/keys-kept.mjs",
    "vault-run": "./bin/vault-run.mjs",
    "vault-mcp": "./bin/vault-mcp.mjs",
    "vault-scan": "./bin/vault-scan.mjs",
    "vault-check": "./bin/vault-check.mjs",
    "vault-push": "./bin/vault-push.mjs"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "age-encryption": "^0.3.1"
  },
  "devDependencies": {
    "@vault/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
